# 默认交由 Git 自动识别文本，统一使用 LF 存储
* text=auto

# ===== 源码：统一 LF =====
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.python text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.gradle text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# ===== Windows 脚本：保持 CRLF =====
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ===== 二进制文件：不做换行转换 =====
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.so    binary
*.apk   binary
*.jar   binary
*.zip   binary
